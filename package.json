{
  "name": "raiko.js",
  "version": "1.0.3",
  "description": "The full stack TypeScript framework: Next.js style app router, server components, typed API, WebSockets with encryption, auth, admin and email. Runs on Bun, Node, Deno, Cloudflare Workers and Vercel.",
  "type": "module",
  "license": "MIT",
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "homepage": "https://kwy404.github.io/Raiko.js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/Raiko.js.git"
  },
  "bugs": {
    "url": "https://github.com/kwy404/Raiko.js/issues"
  },
  "keywords": [
    "framework",
    "web",
    "http",
    "server",
    "typescript",
    "tsx",
    "jsx",
    "ssr",
    "server-components",
    "app-router",
    "websocket",
    "bun",
    "node",
    "deno",
    "cloudflare-workers",
    "vercel",
    "elysia",
    "nextjs",
    "hono",
    "api",
    "openapi",
    "auth",
    "admin"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx/jsx-dev-runtime.js"
    },
    "./app": {
      "types": "./dist/app-router/index.d.ts",
      "import": "./dist/app-router/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./server": {
      "types": "./dist/server/request-store.d.ts",
      "import": "./dist/server/request-store.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./mail": {
      "types": "./dist/mail/index.d.ts",
      "import": "./dist/mail/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    },
    "./package.json": "./package.json",
    "./p2p": {
      "types": "./dist/p2p/index.d.ts",
      "import": "./dist/p2p/index.js"
    },
    "./p2p/client": {
      "types": "./dist/p2p-client.d.ts",
      "import": "./dist/p2p-client.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.pt-BR.md",
    "README.es.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --watch examples/hello/server.ts",
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:node": "node test/node/smoke.mjs",
    "fuzz": "FUZZ_RUNS=100000 bun test --timeout 0 test/fuzz.test.ts",
    "typecheck": "tsc -p .",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.1.13",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "fast-check": "3.23.1",
    "glyphfox": "1.3.0",
    "marked": "15.0.4",
    "react": "18.3.1",
    "terser": "5.36.0",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "valibot": "1.0.0",
    "vite": "5.4.11",
    "vue": "3.5.13",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "bin": {
    "raiko": "./bin/raiko.mjs"
  }
}