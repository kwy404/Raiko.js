{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "raiko.js",
    "paths": { "raiko.js": ["./src/index.ts"], "raiko.js/*": ["./src/*"], "raiko.js/jsx-runtime": ["./src/jsx/jsx-runtime.ts"], "raiko.js/jsx-dev-runtime": ["./src/jsx/jsx-dev-runtime.ts"] }
  },
  "include": ["src", "test"]
}
